# ==============================================================================
# KONFIGURASI ENVIRONMENT SIMASPRAS V2 (cPanel / Standalone Node.js)
# ==============================================================================

# 1. Koneksi Basis Data MySQL cPanel
# Format: mysql://<username_db>:<password_db>@localhost:3306/<nama_db>
DATABASE_URL="mysql://username_db:PasswordKuatAnda@localhost:3306/nama_database_cpanel"

# 2. Secret Key Autentikasi & JWT Token Session
JWT_SECRET="ganti_dengan_string_acak_panjang_dan_aman_2026_!@#"
NEXTAUTH_SECRET="ganti_dengan_string_acak_panjang_dan_aman_2026_!@#"

# 3. URL Domain & Port Aplikasi
# Ganti dengan domain/subdomain resmi aplikasi Anda di cPanel
NEXTAUTH_URL="https://simaspras.poltekimipas.ac.id"
NEXT_PUBLIC_APP_URL="https://simaspras.poltekimipas.ac.id"
PORT="3000"
NODE_ENV="production"

# 4. Token Keamanan Cron Job Pemeliharaan
CRON_SECRET="ganti_dengan_token_cron_rahasia_simaspras_2026"
